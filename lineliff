<!DOCTYPE html>
<html lang="th" data-theme="light">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>เข้าสู่ระบบ LITALK ผ่าน LINE</title>
    <meta name="description" content="เข้าสู่ระบบ LITALK Education Student Portal ผ่าน LINE LIFF">
    <link rel="icon" href="img/LITALK-Icon.png" type="image/png">

    <!-- Theme: match portal pages so the loading screen doesn't flash white/dark -->
    <script>
        (function () {
            const savedTheme = localStorage.getItem('theme');
            const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            document.documentElement.setAttribute('data-theme', savedTheme || (systemPrefersDark ? 'dark' : 'light'));
        })();
    </script>

    <!-- Project fonts + portal design tokens -->
    <link rel="stylesheet" href="css/fonts.css?v=20260714h">
    <link rel="stylesheet" href="css/student-portal.css?v=20260731b">

    <style>
        /* ---------- LIFF loading screen ---------- */
        .liff-page {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            padding: 0 24px;
            text-align: center;
            gap: 0;
        }

        /* Logo */
        .liff-logo {
            width: 56px;
            height: 56px;
            margin-bottom: 32px;
            border-radius: var(--radius-md);
            box-shadow: var(--shadow-md);
            opacity: 0;
            animation: liff-fade-in 0.5s ease forwards;
        }

        /* Branded spinner — LINE green ring rotating on a subtle track */
        .liff-spinner {
            width: 48px;
            height: 48px;
            border: 3px solid var(--border-color);
            border-top-color: #06C755;
            border-radius: 50%;
            animation: liff-spin 0.85s linear infinite, liff-fade-in 0.4s ease forwards;
            margin-bottom: 28px;
        }

        @keyframes liff-spin {
            to { transform: rotate(360deg); }
        }

        @keyframes liff-fade-in {
            from { opacity: 0; transform: translateY(6px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        /* Status text */
        .liff-status {
            font-size: 1.05rem;
            font-weight: 500;
            color: var(--text-primary);
            margin: 0;
            line-height: 1.6;
            word-break: keep-all;
            overflow-wrap: normal;
            opacity: 0;
            animation: liff-fade-in 0.5s 0.15s ease forwards;
        }

        .liff-sub {
            font-size: 0.82rem;
            color: var(--text-muted);
            margin-top: 10px;
            opacity: 0;
            animation: liff-fade-in 0.5s 0.25s ease forwards;
        }

        /* Error state — retry button */
        .liff-retry {
            display: none;
            margin-top: 24px;
            padding: 12px 28px;
            border: none;
            border-radius: var(--radius-sm);
            background: var(--brand-gradient);
            color: var(--brand-btn-text);
            font-family: inherit;
            font-size: 0.92rem;
            font-weight: 600;
            cursor: pointer;
            box-shadow: var(--brand-btn-shadow);
            transition: box-shadow 0.25s, transform 0.25s;
        }

        .liff-retry:hover {
            box-shadow: var(--brand-btn-shadow-hover);
            transform: translateY(-1px);
        }

        .liff-retry:active {
            transform: translateY(0);
        }

        /* Success state — brief flash before redirect */
        .liff-status.is-success {
            color: var(--accent-success);
        }

        /* Error state — red tint */
        .liff-status.is-error {
            color: var(--accent-danger);
        }

        .liff-spinner.is-done {
            border-color: var(--accent-success);
            border-top-color: var(--accent-success);
            animation: none;
        }

        .liff-spinner.is-error {
            border-color: var(--accent-danger);
            border-top-color: var(--accent-danger);
            animation: none;
        }
    </style>
</head>

<body>
    <div class="liff-page">
        <img src="img/LITALK-Icon.png" alt="LITALK" class="liff-logo">
        <div class="liff-spinner" id="liff-spinner"></div>
        <h1 class="liff-status" id="liff-status">กำลังเชื่อมต่อระบบ กรุณารอสักครู่...</h1>
        <p class="liff-sub" id="liff-sub">กำลังยืนยันตัวตนผ่าน LINE</p>
        <button class="liff-retry" id="liff-retry" onclick="location.reload()">
            ลองอีกครั้ง
        </button>
    </div>

    <!-- LINE LIFF SDK -->
    <script src="https://static.line-scdn.net/liff/edge/2/sdk.js"></script>
    <script>
        async function initializeMiniApp() {
            const statusEl  = document.getElementById('liff-status');
            const subEl     = document.getElementById('liff-sub');
            const spinnerEl = document.getElementById('liff-spinner');
            const retryEl   = document.getElementById('liff-retry');

            function showError(msg) {
                statusEl.textContent = msg;
                statusEl.classList.add('is-error');
                spinnerEl.classList.add('is-error');
                subEl.textContent = 'หากปัญหายังคงอยู่ กรุณาติดต่อแอดมินทาง LINE OA';
                retryEl.style.display = 'inline-block';
            }

            try {
                await liff.init({
                    liffId: "2010140183",
                    withLoginOnExternalBrowser: true
                });

                if (liff.isLoggedIn()) {
                    statusEl.textContent = 'เข้าสู่ระบบสำเร็จ กำลังนำท่านเข้าสู่ระบบ...';
                    statusEl.classList.add('is-success');
                    spinnerEl.classList.add('is-done');
                    subEl.textContent = '';

                    // ดึงข้อมูลผู้ใช้งาน LINE
                    const profile = await liff.getProfile();

                    // บันทึกข้อมูลลง localStorage ให้ student.html อ่านได้
                    localStorage.setItem('student_line_uid', profile.userId);
                    localStorage.setItem('student_line_name', profile.displayName);
                    localStorage.setItem('student_line_pic', profile.pictureUrl || '');

                    // ใช้ replace เพื่อไม่ให้ผู้ใช้กดย้อนกลับมาหน้าโหลดดิ้งได้
                    window.location.replace('student.html');
                } else {
                    // withLoginOnExternalBrowser ควรเปิดหน้า LINE Login อัตโนมัติ
                    // กรณี fallback ให้เรียก liff.login() ตรง ๆ
                    statusEl.textContent = 'กำลังเข้าสู่ระบบผ่าน LINE...';
                    subEl.textContent = 'ระบบกำลังพาคุณไปหน้าเข้าสู่ระบบ';
                    liff.login();
                }
            } catch (err) {
                console.error('LIFF Init Error:', err);
                showError('ไม่สามารถเชื่อมต่อระบบได้ กรุณาลองเข้าใหม่อีกครั้ง');
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            initializeMiniApp();
        });
    </script>
</body>

</html>
